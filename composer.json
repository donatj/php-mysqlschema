{
	"name": "donatj/mysql-schema",
	"type": "library",
	"description": "Object Hierarchy Representing MySQL Schema",
	"keywords": [
		"mysql",
		"schema",
		"modeling"
	],
	"require-dev": {
		"corpus/coding-standard": "^0.9",
		"donatj/drop": "*",
		"friendsofphp/php-cs-fixer": "^3.95",
		"donatj/mddoc": "^0.12 || ^0.13",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "~9|~11",
		"squizlabs/php_codesniffer": "^3.6"
	},
	"license": "MIT",
	"authors": [
		{
			"name": "Jesse Donat",
			"email": "donatj@gmail.com",
			"homepage": "https://donatstudios.com",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"autoload": {
		"psr-4": {
			"donatj\\MySqlSchema\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Test\\": "test/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
